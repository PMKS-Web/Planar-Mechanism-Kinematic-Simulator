{
  "name": "pmksweb",
  "version": "3.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check": "npm run lint && npm run lint:styles && npm run lint:format",
    "lint": "eslint src --max-warnings 15",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "fixture-urls": "PMKS_WRITE_FIXTURE_URLS=1 ng test --watch=false --include=src/tests/verification/fixture-gallery.spec.ts",
    "template-payloads": "PMKS_WRITE_TEMPLATE_PAYLOADS=1 ng test --watch=false --include=src/tests/verification/template-payloads.spec.ts",
    "storybook": "ng run PMKSWeb:storybook",
    "build-storybook": "ng run PMKSWeb:build-storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@emailjs/browser": "^3.10.0",
    "@netlify/functions": "^1.4.0",
    "@svgdotjs/svg.draggable.js": "^3.0.2",
    "@svgdotjs/svg.js": "^3.1.2",
    "@svgdotjs/svg.panzoom.js": "^2.1.2",
    "apexcharts": "5.15.2",
    "firebase": "^12.15.0",
    "hammerjs": "^2.0.8",
    "hull.js": "github:AndriiHeonia/hull#v1.0.13",
    "polygon-clipping": "^0.15.7",
    "rxjs": "~7.8.2",
    "svg-pan-zoom": "^3.6.1",
    "tslib": "^2.4.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular-devkit/architect": "^0.2201.8",
    "@angular-devkit/core": "^22.1.8",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/angular-vite": "^10.6.0",
    "@types/hammerjs": "^2.0.41",
    "@types/hull.js": "^1.0.2",
    "@types/node": "^24.13.2",
    "dxf-parser": "^1.1.2",
    "eslint": "^10.10.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "postcss-scss": "^4.0.9",
    "prettier": "3.9.6",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.9"
  }
}
